# ============================================================
# 智水监测系统 - 环境变量示例
# 复制为 .env 并填写真实值。切勿在此文件写入真实凭据。
# 注意：本项目不会自动读取 .env，请将下列变量配置到
#       运行环境（如 Render Environment Variables）。
# ============================================================

# 成都政务开放数据：根据测站编码查询雨情信息
# 真实雨情接口地址（默认已指向官方地址）
CHENGDU_API_BASE_URL=https://www.chengdu.gov.cn/data/gateway/api/1/sswj/gjczbmcxyqxx

# 成都政务开放平台申请到的 Client ID（请留空后填入本地 .env / Render）
CHENGDU_CLIENT_ID=

# 成都政务开放平台申请到的 Client Secret（请留空后填入本地 .env / Render，禁止写入代码或 Git）
CHENGDU_CLIENT_SECRET=

# API 请求超时（秒）
CHENGDU_API_TIMEOUT=10

# 系统站点 ID -> 官方测站编码(stcd) 映射（JSON），例如：
# CHENGDU_STATION_CODES={"ST001":"12345678","ST002":"87654321"}
# 未确认真实 stcd 时留空（系统自动回退到模拟数据，绝不伪造）
CHENGDU_STATION_CODES={}