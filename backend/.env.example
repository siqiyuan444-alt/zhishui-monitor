# Backend environment variables
# Copy this file to .env and modify as needed

# CORS allowed origins (comma-separated)
# For production, set to your website's public URL
# CORS_ORIGINS=https://your-domain.com,http://your-server-ip:8000
# Leave empty to use defaults (localhost only)

# --- AI 智能水情分析（可选，Stage 20B） ---
# 未配置以下任何一项时，系统自动使用规则分析（RuleBasedAnalyzer），不会启动失败。
# AI_ANALYZER=rule_based
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT=30
# AI_ANALYSIS_CACHE_SECONDS=60

# --- AI 调用限流（Stage 21）---
# 仅真实 AI 模式生效；按登录用户或客户端 IP 维度滑动窗口限流。
# AI_RATE_LIMIT_PER_MINUTE=10

# --- 生产安全（Stage 21）---
# JWT 签名密钥：生产必须设置为固定随机值，否则每次重启签发的 token 全部失效。
# JWT_SECRET_KEY=
# JWT_EXPIRE_MINUTES=60
# 响应安全头 CSP 开关（默认开启；关闭时仍保留 X-Content-Type-Options 等基础头）。
# ENABLE_CSP=1
