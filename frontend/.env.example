# Frontend environment variables
# Copy this file to .env and modify as needed

# Backend API address (used when building for production)
# For local development, default is http://127.0.0.1:8000
# For production, set to your server's public URL, e.g.:
# VITE_API_BASE_URL=http://your-server-ip:8000
# VITE_API_BASE_URL=https://your-domain.com
